/* Tracking QA — dùng biến màu của Editor để hợp cả theme sáng / tối; màu nhóm cố định, chữ trắng */
.tqa {
    --c-err: #d64545;
    --c-warn: #c27c0e;
    --c-miss: #7a5af8;
    --c-doc: #2f80ed;
    --c-info: #6b7280;
    --c-acc: #2e9d5b;
    flex-grow: 1;
    padding: 6px 8px 4px 8px;
}

.hrow { flex-direction: row; align-items: center; }

/* Các khối trên / dưới giữ đủ chiều cao (không bị co → chữ đè nhau); danh sách | chi tiết chiếm phần còn lại */
.tqa > * { flex-shrink: 0; }
.tqa > .split { flex-shrink: 1; flex-grow: 1; min-height: 160px; }
.tqa > .empty { flex-shrink: 1; }

/* Hàng trên */
.top { margin-bottom: 4px; }
.top > Button { flex-shrink: 0; }
.game { -unity-font-style: bold; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.doc { flex-grow: 1; flex-shrink: 1; min-width: 60px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 4px; color: var(--unity-colors-default-text); }
.doc.missing { color: var(--c-warn); }
.seg { margin: 0 6px; flex-shrink: 0; }
.seg > Button { margin: 0; border-radius: 0; min-width: 62px; }
.seg > Button.on { background-color: var(--unity-colors-highlight-background); color: #ffffff; }
Button.primary { background-color: #2f6fd6; color: #ffffff; -unity-font-style: bold; min-width: 96px; height: 24px; }
Button.primary:hover { background-color: #3b7de8; }
Button.primary:disabled { background-color: var(--unity-colors-button-background); color: var(--unity-colors-default-text); }

.status { margin: 2px 0 4px 0; white-space: normal; color: var(--unity-colors-default-text); opacity: 0.85; }
.status.running { -unity-font-style: italic; }

/* Tóm tắt */
.summary { margin-bottom: 4px; }
.meta { white-space: normal; opacity: 0.8; margin-bottom: 4px; }
.cov-row { margin-bottom: 2px; flex-wrap: wrap; }
.cov-row > Button { flex-shrink: 0; }
.coverage { -unity-font-style: bold; margin-right: 8px; }
.coverage.good { color: var(--c-acc); }
.coverage.bad { color: var(--c-warn); }
.blind Label { white-space: normal; opacity: 0.85; }
.filter { flex-wrap: wrap; margin-top: 4px; }
.chips { flex-wrap: wrap; }
.search { width: 200px; flex-shrink: 1; margin-left: 6px; }

.chip { border-radius: 10px; padding: 1px 10px; margin: 2px 4px 2px 0; border-width: 1px; background-color: rgba(0,0,0,0); opacity: 0.55; }
.chip.on { opacity: 1; -unity-font-style: bold; color: #ffffff; }
.chip.err { border-color: var(--c-err); } .chip.err.on { background-color: var(--c-err); }
.chip.warn { border-color: var(--c-warn); } .chip.warn.on { background-color: var(--c-warn); }
.chip.miss { border-color: var(--c-miss); } .chip.miss.on { background-color: var(--c-miss); }
.chip.doc { border-color: var(--c-doc); } .chip.doc.on { background-color: var(--c-doc); }
.chip.info { border-color: var(--c-info); } .chip.info.on { background-color: var(--c-info); }
.chip.acc { border-color: var(--c-acc); } .chip.acc.on { background-color: var(--c-acc); }
/* Kết quả case */
.chip.vio { border-color: var(--c-err); } .chip.vio.on { background-color: var(--c-err); }
.chip.pass { border-color: var(--c-acc); } .chip.pass.on { background-color: var(--c-acc); }
.chip.todo { border-color: var(--c-warn); } .chip.todo.on { background-color: var(--c-warn); }
.chip.na { border-color: var(--c-info); } .chip.na.on { background-color: var(--c-info); }
.chip.draft { border-color: var(--c-info); } .chip.draft.on { background-color: var(--c-info); }
.seg.mode { margin: 2px 8px 2px 0; }

/* Danh sách | chi tiết */
.split { flex-grow: 1; border-top-width: 1px; border-color: var(--unity-colors-default-border); }
.list { min-width: 220px; }
.row { padding: 4px 6px; height: 44px; justify-content: center; }
.row-1 { margin-bottom: 2px; }
.row .pill, .row .fid { white-space: nowrap; flex-shrink: 0; }
.row-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subj { -unity-font-style: bold; margin-left: 6px; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.fid { margin-left: 6px; opacity: 0.55; font-size: 10px; }

.pill { color: #ffffff; border-radius: 3px; padding: 0 5px; font-size: 10px; -unity-font-style: bold; }
.pill.err { background-color: var(--c-err); }
.pill.warn { background-color: var(--c-warn); }
.pill.miss { background-color: var(--c-miss); }
.pill.doc { background-color: var(--c-doc); }
.pill.info { background-color: var(--c-info); }
.pill.acc { background-color: var(--c-acc); }
.pill.vio { background-color: var(--c-err); }
.pill.pass { background-color: var(--c-acc); }
.pill.todo { background-color: var(--c-warn); }
.pill.na, .pill.draft { background-color: var(--c-info); }

.detail-scroll { flex-grow: 1; }
.detail { padding: 8px 12px 16px 12px; }
.detail Label { white-space: normal; flex-shrink: 1; }
.detail .tag, .detail .pill { white-space: nowrap; flex-shrink: 0; }
.detail-text { padding: 6px 8px; background-color: var(--unity-colors-helpbox-background); border-radius: 3px; }
.d-head { flex-wrap: wrap; margin-bottom: 4px; }
.d-title { font-size: 14px; -unity-font-style: bold; white-space: normal; margin: 4px 0 8px 0; }
.tag { border-radius: 3px; padding: 0 5px; margin: 1px 4px 1px 4px; border-width: 1px; border-color: var(--unity-colors-default-border); font-size: 10px; }
.tag.subj-tag { -unity-font-style: bold; font-size: 11px; }
.tag.pkg { border-color: var(--c-doc); color: var(--c-doc); }
.tag.ai { border-color: var(--c-warn); color: var(--c-warn); }
.tag.case { border-color: #4c8ff5; color: #4c8ff5; cursor: link; }
.case-finding { margin: 2px 0; align-items: flex-start; }
.case-finding > .pill { margin-right: 6px; flex-shrink: 0; }
.detail .case-link { white-space: normal; flex-shrink: 1; }

.tabs { margin: 6px 0 8px 0; border-bottom-width: 1px; border-color: var(--unity-colors-default-border); }
.tab { margin: 0 2px -1px 0; border-radius: 0; border-width: 0 0 2px 0; border-color: rgba(0,0,0,0); background-color: rgba(0,0,0,0); padding: 4px 12px; opacity: 0.65; }
.tab.on { border-color: #2f6fd6; opacity: 1; -unity-font-style: bold; }

.para { white-space: normal; margin: 2px 0 4px 0; }
.why { font-size: 12px; margin-bottom: 8px; }
.sugg { margin-top: 8px; padding: 6px 8px; border-left-width: 3px; border-color: var(--c-acc); background-color: rgba(46,157,91,0.10); }
.na { padding: 8px; background-color: var(--unity-colors-helpbox-background); }
.muted { opacity: 0.6; white-space: normal; margin: 2px 0; font-size: 11px; }
.section { -unity-font-style: bold; margin: 10px 0 4px 0; opacity: 0.85; }
.detail .code { white-space: pre; overflow: hidden; background-color: var(--unity-colors-helpbox-background); padding: 6px 8px; margin: 4px 0 6px 0; font-size: 11px; border-radius: 3px; }

.trace { margin: 0 0 8px 0; padding: 4px 0 4px 8px; border-left-width: 2px; border-color: var(--unity-colors-default-border); }
.tr-entry { flex-wrap: wrap; margin-bottom: 2px; }
.hop { margin: 1px 0 1px 4px; align-items: flex-start; }
.hop-col { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hop.last .member { -unity-font-style: bold; }
.hop-n { opacity: 0.5; min-width: 18px; }
.member { margin-right: 6px; }
.detail .link { color: #4c8ff5; margin-right: 6px; cursor: link; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 40px; }
.link:hover { -unity-font-style: italic; }
.ev { margin: 1px 0; }

.rp-src { flex-wrap: wrap; margin-bottom: 6px; }
.steps { margin: 4px 0 8px 0; }
.step { align-items: flex-start; margin-bottom: 4px; }
.step-n { min-width: 20px; height: 18px; border-radius: 9px; background-color: #2f6fd6; color: #ffffff; -unity-text-align: middle-center; margin-right: 8px; font-size: 10px; -unity-font-style: bold; }
.step > .para { flex-shrink: 1; flex-grow: 1; margin: 1px 0 0 0; }
.ea { align-items: stretch; margin: 4px 0 8px 0; }
.ea-box { flex-grow: 1; flex-basis: 0; padding: 6px 8px; margin-right: 6px; border-radius: 3px; border-left-width: 3px; }
.ea-box.exp { border-color: var(--c-acc); background-color: rgba(46,157,91,0.10); }
.ea-box.act { border-color: var(--c-err); background-color: rgba(214,69,69,0.10); }
.ea-k { -unity-font-style: bold; font-size: 10px; opacity: 0.8; margin-bottom: 2px; }

/* Đúng thiết kế */
.accept-btn { align-self: flex-start; margin: 0 0 4px 0; }
.accept-form { padding: 8px; margin-bottom: 6px; background-color: var(--unity-colors-helpbox-background); border-radius: 3px; }
.accept-form > Label { white-space: normal; }
.reason { min-height: 44px; margin: 4px 0; }
.reason TextInput { white-space: normal; }
.accept-btns > Button { min-width: 70px; }
.accepted-box { padding: 8px; margin-bottom: 6px; border-left-width: 3px; border-color: var(--c-acc); background-color: rgba(46,157,91,0.10); }
.accepted-box > Label { white-space: normal; margin-bottom: 4px; }
.accepted-box > Button { align-self: flex-start; }

.empty { white-space: normal; padding: 24px; -unity-text-align: middle-center; opacity: 0.7; flex-grow: 1; }
.log { margin-top: 4px; max-height: 180px; }
.log Label { white-space: normal; font-size: 11px; }

/* Kịch bản (log giả lập) */
.sc-item { align-items: flex-start; margin: 2px 0; }
.sc-item > .tag { flex-shrink: 0; margin-top: 2px; }
.sc-check { margin: 2px 0; }
.sc-check.error { color: var(--c-err); }
.sc-check.warn { color: var(--c-warn); }
.sc-check.ok { color: var(--c-acc); }

/* Record */
.rec-status { margin-left: 8px; -unity-font-style: bold; }
.rec-status.live { color: var(--c-err); }
.rec-sessions { min-width: 220px; }
.sc-check.known { opacity: 0.55; }
